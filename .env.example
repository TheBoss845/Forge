# ---------------------------------------------------------------------------
# Forge environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and must never reach client code.
#
# Forge runs without any of these set: pages that need a missing service
# show an honest "not configured" notice instead of failing.
# ---------------------------------------------------------------------------

# --- Supabase (authentication + database) -----------------------------------
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API. Apply supabase/migrations/0001_initial_schema.sql
# via the SQL editor or `supabase db push`.
# The URL and anon key are safe for the client; access is enforced by
# row-level security policies, not by hiding these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key bypasses row-level security. Server-only. Never expose.
# (Not required by the current feature set; reserved for admin jobs.)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (discovery interview + blueprints) -------------------------
# Easiest: set just OPENAI_API_KEY (or ANTHROPIC_API_KEY). Forge infers the
# provider and uses a sensible default model.
OPENAI_API_KEY=

# Advanced/explicit configuration (all optional):
# AI_PROVIDER: "openai" or "anthropic".
# AI_MODEL: model identifier, e.g. "gpt-4o" or "claude-sonnet-4-5".
# AI_API_KEY: generic key, used with AI_PROVIDER.
# AI_BASE_URL: override for OpenAI-compatible APIs.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# --- Application -------------------------------------------------------------
# Absolute URL of the deployed app, used for auth redirect links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
