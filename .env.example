# ---------------------------------------------------------------------------
# Forge environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and must never reach client code.
# ---------------------------------------------------------------------------

# --- Supabase (required from Milestone 3: Authentication) -------------------
# Project URL and anonymous key are safe for the client; access is enforced
# by row-level security policies, not by hiding these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key bypasses row-level security. Server-only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (required from Milestone 6: Discovery interview) -----------
# Forge uses a provider abstraction; configure exactly one provider.
# AI_PROVIDER: which provider the abstraction should use (e.g. "openai",
# "anthropic"). AI_MODEL: the model identifier for that provider.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# --- Application -------------------------------------------------------------
# Absolute URL of the deployed app, used for auth redirects and emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
